#!/bin/sh
# Project-local nine-tails: runs the freshly built binary from this checkout
# (make build first). It does not pick a store: the store is the ordinary one
# (NINE_TAILS_HOME if set, else ~/.nine-tails), so every clone and worktree of
# this repository shares one memory. This is the dogfooding entry point.
ROOT="$(cd "$(dirname "$0")" && pwd)"
exec "$ROOT/bin/nine-tails" "$@"
